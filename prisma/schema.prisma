generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id         Int           @id @default(autoincrement())
  name       String
  status     CompanyStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  assistants Assistant[]
  users      User[]
}

model User {
  id        Int      @id @default(autoincrement())
  companyId Int?
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(COMPANY_ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id])
}

model Assistant {
  id                           Int             @id @default(autoincrement())
  companyId                    Int
  name                         String          @default("Trevos Assistant")
  status                       AssistantStatus @default(ACTIVE)
  publicApiKey String? @unique
  welcomeMessage               String?
  systemPrompt                 String?
  monthlyMessageLimit          Int             @default(500)
  monthlyMessageUsed           Int             @default(0)
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  collectEmail                 Boolean         @default(true)
  collectInterest              Boolean         @default(true)
  collectName                  Boolean         @default(true)
  collectPhone                 Boolean         @default(false)
  leadCaptureEnabled           Boolean         @default(true)
  leadCaptureMessage           String?
  emailNotificationsEnabled    Boolean         @default(true)
  notificationEmail            String?
  notificationMessage          String?
  notificationWhatsapp         String?
  notificationsEnabled         Boolean         @default(true)
  whatsappNotificationsEnabled Boolean         @default(false)
  company                      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations                Conversation[]
  knowledgeItems               KnowledgeItem[]
  leads                        Lead[]
  notifications                Notification[]
  usageRecords                 UsageRecord[]

  @@index([companyId])
}

model KnowledgeItem {
  id          Int       @id @default(autoincrement())
  assistantId Int
  title       String
  content     String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@index([assistantId])
}

model Conversation {
  id           Int       @id @default(autoincrement())
  assistantId  Int
  visitorName  String?
  visitorEmail String?
  visitorPhone String?
  startedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assistant    Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  messages     Message[]
  leads Lead[]

  @@index([assistantId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  sender         String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Lead {
  id             Int            @id @default(autoincrement())
  assistantId    Int
  conversationId Int?
  name           String
  email          String?
  phone          String?
  interest       String?
  status         LeadStatus     @default(NEW)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  assistant      Assistant      @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  notifications  Notification[]

  @@index([assistantId])
  @@index([conversationId])
}

model Notification {
  id          Int                 @id @default(autoincrement())
  assistantId Int
  leadId      Int?
  channel     NotificationChannel
  recipient   String
  message     String
  status      NotificationStatus  @default(PENDING)
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
  assistant   Assistant           @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  lead        Lead?               @relation(fields: [leadId], references: [id])

  @@index([assistantId])
  @@index([leadId])
}

model UsageRecord {
  id          Int       @id @default(autoincrement())
  assistantId Int
  month       String
  messages    Int       @default(0)
  leads       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@unique([assistantId, month])
  @@index([assistantId])
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  STAFF
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum AssistantStatus {
  ACTIVE
  INACTIVE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}
